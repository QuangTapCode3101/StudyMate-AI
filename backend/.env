PORT=3000
# Để true trong tuần đầu để M2, M3, M4 test UI thoải mái không tốn Quota Gemini
USE_MOCK_AI=true

# M5 có thể điền nhiều API Key cách nhau bằng dấu phẩy để tự động xoay vòng khi hết quota
GEMINI_API_KEYS=your_api_key_1,your_api_key_2
GEMINI_MODEL=gemini-2.5-flash

# Cấu hình Rate Limit chuẩn Rubric Đề số 7
MAX_REQUESTS_PER_MINUTE=5
MAX_REQUESTS_PER_DAY=20